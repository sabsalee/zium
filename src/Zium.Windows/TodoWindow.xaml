<Window x:Class="Zium.Windows.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="PanelWindow" Title="Zium · 할 일" Width="346" Height="369"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Icon="zium.ico"
        FontFamily="{StaticResource AppFont}" FontSize="14" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style x:Key="ResizeTarget" TargetType="Thumb">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="DragStarted" Handler="ResizeStarted"/>
      <EventSetter Event="DragDelta" Handler="ResizeMoved"/>
      <EventSetter Event="DragCompleted" Handler="ResizeCompleted"/>
    </Style>
  </Window.Resources>
  <Grid x:Name="WindowSurface">
  <Border Margin="12" Background="{DynamicResource PanelBrush}" CornerRadius="12" IsHitTestVisible="False">
    <Border.Effect><DropShadowEffect Color="#182131" BlurRadius="16" ShadowDepth="3" Opacity=".37" RenderingBias="Performance"/></Border.Effect>
  </Border>
  <Border x:Name="PanelFrame" Margin="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
          BorderThickness="1" CornerRadius="12" Padding="11,8,11,11">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="DragHandle" Background="Transparent" Padding="5,1,7,1" Cursor="SizeAll"
                  ToolTip="끌어서 옮기기" MouseLeftButtonDown="DragStarted" MouseMove="DragMoved"
                  MouseLeftButtonUp="DragReleased" LostMouseCapture="DragCaptureLost">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="할 일" FontWeight="SemiBold" FontSize="14" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                         VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" x:Name="TaskCount" FontSize="14" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
          </Border>
          <Button x:Name="PinButton" Grid.Column="1" Style="{StaticResource QuietButton}" Click="PinClicked"
                  Width="32" Height="31" ToolTip="항상 위에 고정" AutomationProperties.Name="항상 위에 고정">
            <Path Data="M 9,2 L 14,7 M 10,3 L 6,7 L 4,7 L 3,8 L 8,13 L 9,12 L 9,10 L 13,6 M 5.5,10.5 L 2,14"
                  Stroke="{Binding Foreground, ElementName=PinButton}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource QuietButton}" Click="HideClicked" Width="32" Height="31"
                  ToolTip="화면 가장자리에 접기" AutomationProperties.Name="화면 가장자리에 접기">
            <Path Data="M 2,8 H 13" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"/>
          </Button>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" x:Name="TaskScroll" Margin="0,5,0,5" VerticalScrollBarVisibility="Auto" Background="Transparent"
                    HorizontalScrollBarVisibility="Disabled" AllowDrop="True" PreviewDragOver="OrderScrollDragOver"
                    Drop="OrderScrollDrop">
        <Grid>
          <TextBlock Text="할 일을 한 줄 적어보세요." x:Name="EmptyMessage" IsHitTestVisible="False"
                     Margin="7,9" Foreground="{DynamicResource MutedBrush}"/>
          <ItemsControl x:Name="TaskList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,1" CornerRadius="6" Background="Transparent" AllowDrop="True"
                        DragOver="OrderDragOver" DragLeave="OrderDragLeave"
                        Drop="OrderDrop" ToolTip="끌어서 순서 변경 · 우클릭하거나 F2를 눌러 편집">
                  <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                      <MenuItem Header="항목 편집 · 메모" InputGestureText="F2" Click="EditMenuClicked"/>
                      <MenuItem Header="삭제" Click="DeleteMenuClicked"/>
                    </ContextMenu>
                  </Border.ContextMenu>
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Margin="6,0,0,0" Width="19" Height="25"
                              VerticalAlignment="Center" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                              AutomationProperties.Name="{Binding Title}" Click="TaskChecked"/>
                    <Button x:Name="TaskHeader" Grid.Column="1" Style="{StaticResource QuietButton}" Click="TaskHeaderClicked"
                            Tag="{Binding}" HorizontalContentAlignment="Stretch" MinHeight="32" Padding="2,4,6,4"
                            PreviewMouseLeftButtonDown="OrderPressed" PreviewMouseMove="OrderMoved"
                            AutomationProperties.Name="{Binding HeaderName}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TaskTitle" Text="{Binding Title}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        <Path x:Name="Chevron" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                              Data="M 1,2 L 5,6 L 9,2" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                              Visibility="{Binding HasNote, Converter={StaticResource VisibleWhenTrue}}"/>
                      </Grid>
                    </Button>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="3,0,9,6"
                                Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}}">
                      <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="13"
                                 Foreground="{DynamicResource MutedBrush}"/>
                      <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Right" FontSize="12"
                              Content="메모 편집" Padding="5,1" Margin="0,2,0,0" Tag="{Binding}" Click="NoteEditClicked"/>
                    </StackPanel>
                    <Border Grid.RowSpan="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource AccentBrush}"
                            IsHitTestVisible="False"/>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="TaskTitle" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    <Setter TargetName="TaskTitle" Property="TextDecorations" Value="Strikethrough"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Data" Value="M 1,6 L 5,2 L 9,6"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>
      <TextBlock x:Name="Notice" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="4,0,4,6" Visibility="Collapsed"/>
      <Grid Grid.Row="3">
        <Grid x:Name="QuickEntry" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="NewTitle" Style="{StaticResource EditorField}" MinHeight="35" MaxLength="240"
                   VerticalContentAlignment="Center" AutomationProperties.Name="새 할 일" PreviewKeyDown="NewTitleKeyDown"/>
          <TextBlock x:Name="Placeholder" Text="할 일 적기" Margin="8,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=NewTitle}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="AddClicked" Width="34" Height="35"
                  ToolTip="할 일 추가 (Enter)" AutomationProperties.Name="할 일 추가">
            <Path Data="M 2,7 H 12 M 7,2 V 12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
          </Button>
        </Grid>
        <StackPanel x:Name="EditFields" Visibility="Collapsed">
          <TextBox x:Name="EditTitle" Style="{StaticResource EditorField}" MaxLength="240"
                   AutomationProperties.Name="할 일 제목"/>
          <Grid Margin="0,4,0,0">
            <TextBox x:Name="EditNote" Style="{StaticResource EditorField}" AcceptsReturn="True"
                     TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" MaxLength="8000"
                     AutomationProperties.Name="메모" ToolTip="메모를 여러 줄로 적을 수 있어요"/>
            <TextBlock Text="메모 적기" Margin="8,6,0,0" VerticalAlignment="Top" IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=EditNote}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <DockPanel Margin="0,3,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Foreground="{DynamicResource AccentBrush}"
                    Content="저장" Click="SaveEditClicked"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="취소" Click="CancelEditClicked"/>
            <TextBlock DockPanel.Dock="Left" Text="제목 · 메모" VerticalAlignment="Center" Margin="4,0,0,0"
                       Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
          </DockPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
  <Grid Margin="12">
    <Thumb Tag="N" Height="6" Margin="12,0" VerticalAlignment="Top" Cursor="SizeNS" Style="{StaticResource ResizeTarget}"/>
    <Thumb Tag="S" Height="6" Margin="12,0" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource ResizeTarget}"/>
    <Thumb Tag="W" Width="6" Margin="0,12" HorizontalAlignment="Left" Cursor="SizeWE" Style="{StaticResource ResizeTarget}"/>
    <Thumb Tag="E" Width="6" Margin="0,12" HorizontalAlignment="Right" Cursor="SizeWE" Style="{StaticResource ResizeTarget}"/>
    <Thumb Tag="NW" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Style="{StaticResource ResizeTarget}"/>
    <Thumb Tag="NE" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Style="{StaticResource ResizeTarget}"/>
    <Thumb Tag="SW" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{StaticResource ResizeTarget}"/>
    <Thumb Tag="SE" Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource ResizeTarget}"/>
    <Path x:Name="ResizeMark" Margin="3" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Data="M 1,7 L 7,1 M 5,7 L 7,5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"
          IsHitTestVisible="False" RenderTransformOrigin=".5,.5"/>
  </Grid>
  </Grid>
</Window>
