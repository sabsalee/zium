<Window x:Class="Zium.Windows.UpdateSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zium · 자동 업데이트" Width="395" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Icon="zium.ico"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="14">
  <StackPanel Margin="17">
    <DockPanel Margin="0,0,0,8">
      <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="자동 업데이트" FontWeight="SemiBold" FontSize="17"/>
    </DockPanel>
    <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" MinHeight="44" Margin="0,0,0,8"
               AutomationProperties.LiveSetting="Polite"/>
    <StackPanel x:Name="Credentials">
      <TextBlock Text="Fine-grained 토큰을 만들고 sabsalee/zium 저장소에 Contents 읽기 권한을 주세요."
                 TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
      <Button Content="GitHub에서 토큰 만들기" Click="OpenTokenPage" Style="{StaticResource QuietButton}"
              Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,2,0,5"/>
      <PasswordBox x:Name="TokenInput" AutomationProperties.Name="GitHub 토큰" MaxLength="255"
                   Padding="7,5" MinHeight="32" Foreground="{DynamicResource TextBrush}"
                   Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource DividerBrush}"
                   CaretBrush="{DynamicResource TextBrush}" PasswordChanged="TokenChanged"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,5">
        <Button x:Name="DisconnectButton" Content="연결 해제" Click="DisconnectClicked" Style="{StaticResource QuietButton}"/>
        <Button x:Name="ConnectButton" Content="토큰 연결" Click="ConnectClicked" Style="{StaticResource QuietButton}"
                Foreground="{DynamicResource AccentBrush}"/>
      </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CheckButton" Content="지금 확인" Click="CheckClicked" Style="{StaticResource QuietButton}"/>
      <Button x:Name="RestartButton" Content="업데이트하고 다시 시작" Click="RestartClicked" Style="{StaticResource QuietButton}"/>
      <Button Content="닫기" Click="CloseClicked" Style="{StaticResource QuietButton}"/>
    </StackPanel>
  </StackPanel>
</Window>
